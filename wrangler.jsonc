{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seoul-dodam-dental",
  "compatibility_date": "2026-08-25",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seoul-dodam-dental-production",
      "database_id": "355781fd-3658-4d57-bc45-ccd352fed16e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "seoul-dodam-dental-bucket"
    }
  ]
}
