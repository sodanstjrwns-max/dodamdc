{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-image-manifest.mjs && npm run build:experience && npm run build:admin && vite build",
    "build:experience": "rm -rf public/static/experience && esbuild src/client/experience.ts --bundle --splitting --format=esm --target=es2020 --minify --outdir=public/static/experience --entry-names=main --chunk-names=[name]-[hash] --legal-comments=linked",
    "build:admin": "esbuild src/client/admin-sanitizer.ts --bundle --format=iife --global-name=AdminSanitizer --minify --outfile=public/static/admin-sanitizer.js --legal-comments=linked",
    "test:security": "node scripts/security-smoke.mjs",
    "test:design": "node scripts/design-smoke.mjs",
    "test:kinetic": "node scripts/kinetic-smoke.mjs",
    "test:seo": "node scripts/seo-smoke.mjs",
    "test:delivery": "node scripts/delivery-smoke.mjs",
    "test:cms": "node scripts/cms-smoke.mjs",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:journey": "node scripts/journey-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy dist",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "dev:sandbox": "wrangler pages dev dist --local --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply seoul-dodam-dental-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply seoul-dodam-dental-production",
    "db:seed": "wrangler d1 execute seoul-dodam-dental-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test:encyclopedia": "node scripts/encyclopedia-smoke.mjs",
    "test:hours-meta": "node scripts/hours-meta-smoke.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "hono": "^4.13.5",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
